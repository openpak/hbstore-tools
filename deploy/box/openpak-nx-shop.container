# nx-shop: the native eShop, split from nx-baas (nx-baas docs/service-split.md §5).
[Unit]
Description=OpenPak nx-shop (native eShop, split from nx-baas)
# Ordering only: no Requires= on nx-baas, so the shop keeps serving while the core restarts.
After=openpak-nx-baas.service

[Container]
ContainerName=openpak-nx-shop
Image=ghcr.io/openpak/nx-shop:latest
AutoUpdate=registry
Network=openpak.network
EnvironmentFile=%h/openpak/deploy/.env
Environment=NX_CORE_URL=http://openpak-nx-baas:20070 NX_ADDR=:21000 NX_API_ADDR=:20070 NX_DATA=/app/data NX_SHOP_DIR=/app/data/shop NX_CA_DIR=/ca
Environment=BAAS_SIGNING_KEY=/keys/baas_signing_key.pem BAAS_KID=openpak-baas-key-1
# The store stays in nx-baas volume: this mounts that directory itself (same uid 65532), so
# the cut-over moves no bytes and a rollback is a routing change. One writer at a time.
Volume=openpak-nx-shop-data:/app/data
Volume=/home/ubuntu/.local/share/containers/storage/volumes/openpak-nxbaas/_data/shop:/app/data/shop
Volume=%h/openpak/deploy/ca:/ca:ro
Volume=%h/openpak/deploy/keys/baas_signing_key.pem:/keys/baas_signing_key.pem:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
